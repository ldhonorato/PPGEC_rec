DEBUG=False
SECRET_KEY=change-me-to-a-long-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1,192.168.37.71
SITE_URL=https://ppgec.example.edu

SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SECURE=True
CSRF_COOKIE_HTTPONLY=True
CSRF_COOKIE_SAMESITE=Lax
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
SECURE_CONTENT_TYPE_NOSNIFF=True
SECURE_REFERRER_POLICY=same-origin
USE_X_FORWARDED_PROTO=True

USE_POSTGRES=True
POSTGRES_DB=ppgec
POSTGRES_USER=ppgec
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

PGADMIN_DEFAULT_EMAIL=admin@ppgec.local
PGADMIN_DEFAULT_PASSWORD=change-me
PGADMIN_PORT=5050

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=AcadFlow <no-reply@example.edu>

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# --------------------------------------------------------------------------
# Documentos enviados
#
# Sem AWS_STORAGE_BUCKET_NAME, os arquivos ficam em disco (MEDIA_ROOT) -- e o
# modo de desenvolvimento. Com o nome do bucket definido, passam para o S3, e
# as credenciais tornam-se obrigatorias: a aplicacao recusa subir sem elas, em
# vez de falhar so no primeiro upload.
#
# O bucket deve ser PRIVADO, sem acesso publico. A aplicacao confere quem esta
# pedindo o arquivo e so entao assina um endereco de leitura de vida curta.
# --------------------------------------------------------------------------
# AWS_STORAGE_BUCKET_NAME=ppgec-documentos
# AWS_ACCESS_KEY_ID=change-me
# AWS_SECRET_ACCESS_KEY=change-me
# AWS_S3_REGION_NAME=us-east-1
# Vida da URL assinada, em segundos (padrao 300).
# AWS_QUERYSTRING_EXPIRE=300

# Usado apenas quando os arquivos ficam em disco.
# MEDIA_ROOT=/app/media
